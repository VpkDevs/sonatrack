# =============================================================================
# Song Architect (Sonatrack) — Environment Variables Reference
# =============================================================================
# Zero external API keys or databases are required to build and deploy
# Song Architect today. All songwriting workspaces persist locally in browser
# localStorage. Copy this file to `.env` only if you want to customize runtime
# settings locally.

# --- Runtime & Server (artifacts/api-server) ---------------------------------
# Environment mode: development | production
NODE_ENV=development

# Host interface to bind the Express server (use 0.0.0.0 in containers/cloud)
HOST=0.0.0.0

# HTTP listening port (api-server defaults to 8080; song-architect Vite defaults to 5173)
PORT=8080

# Pino logger verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated CORS allowlist for api-server (leave empty or "*" to allow all)
CORS_ORIGIN=*

# Set to "false" to disable serving built frontend assets from api-server
SERVE_STATIC=true

# Optional explicit directory containing Song Architect built static files (index.html)
# Defaults to auto-detecting ./public or ./artifacts/song-architect/dist/public
# STATIC_DIR=/app/public

# --- Frontend Build & Dev Server (artifacts/song-architect) ------------------
# Base public URL path for Vite builds (default: "/")
BASE_PATH=/

# Optional Vite-specific base path override (takes precedence over BASE_PATH)
# VITE_BASE_PATH=/

# Local dev proxy target for /api requests from Vite dev server
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# --- Optional / Future PostgreSQL Persistence (lib/db) -----------------------
# NOT required for Song Architect or api-server today (lib/db schema is currently empty).
# Required only if you add Drizzle tables and run `pnpm --filter @workspace/db run push`.
# DATABASE_URL=postgresql://user:password@localhost:5432/sonatrack
